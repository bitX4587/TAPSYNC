{
  "name": "@tapsync/mobile",
  "version": "0.0.1",
  "private": true,
  "description": "TapSync Expo mobile app",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "eas-build-pre-install": "echo 'pre-install'",
    "eas-build-post-install": "pnpm --filter @tapsync/shared build && npx expo prebuild --platform android --clean"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@tanstack/react-query": "^5.104.4",
    "@tapsync/shared": "workspace:*",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sqlite": "~15.1.4",
    "query-string": "9.5.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-nfc-manager": "^3.14.14",
    "react-native-safe-area-context": "~5.0.0",
    "react-native-screens": "~4.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "metro-minify-terser": "^0.87.3",
    "typescript": "^5.7.3"
  }
}