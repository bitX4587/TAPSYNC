# Next.js env variables – copy to .env.local and fill in

# API URL (server-side fetch)
TAPSYNC_API_URL=http://localhost:3001

# Revalidation
REVALIDATION_SECRET=change-me-revalidation-secret

# Object storage CDN hostname (for next/image remote patterns)
STORAGE_CDN_HOSTNAME=cdn.tapsync.app

# Public URL (used for canonical links and OG tags)
NEXT_PUBLIC_SITE_URL=https://tapsync.app

# ── Sentry error monitoring ───────────────────────────────────────────────────
# Optional – leave empty to disable
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
