# API environment variables – copy to .env and fill in values
# Never commit .env to source control

# MongoDB
MONGODB_URI=mongodb://localhost:27017/tapsync

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=365d

# Google OAuth (server-side token verification)
GOOGLE_CLIENT_ID=

# Next.js revalidation webhook
REVALIDATION_SECRET=change-me-revalidation-secret
NEXT_PUBLIC_URL=http://localhost:3000

# Object storage (S3-compatible)
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_CDN_URL=

# App
PORT=3001
NODE_ENV=development
