# API environment variables – copy to .env and fill in values
# Never commit .env to source control

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Required
MONGODB_URI=mongodb://localhost:27017/tapsync

# ── JWT ───────────────────────────────────────────────────────────────────────
# Required
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Optional – defaults shown
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=365d

# ── Google OAuth (server-side token verification) ─────────────────────────────
# Required
GOOGLE_CLIENT_ID=

# ── Next.js revalidation webhook ─────────────────────────────────────────────
# Required
REVALIDATION_SECRET=change-me-revalidation-secret
# Optional – defaults shown
NEXT_PUBLIC_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins (web app + any staging domains)
CORS_ORIGIN=http://localhost:3000

# ── Object storage (S3-compatible) ────────────────────────────────────────────
# Required
STORAGE_BUCKET=
STORAGE_KEY_ID=
STORAGE_SECRET=
# Optional – defaults shown
STORAGE_REGION=us-east-1
STORAGE_CDN_URL=

# ── Sentry error monitoring ───────────────────────────────────────────────────
# Optional – leave empty to disable
SENTRY_DSN=
